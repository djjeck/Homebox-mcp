{
  "name": "homebox-mcp-server",
  "version": "1.1.5",
  "description": "MCP Server for Homebox Home Inventory System",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "node test-connection.js",
    "test:e2e": "tsc && node dist/test-e2e.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "validate": "npm run lint:fix && npm run format && npm run build"
  },
  "keywords": [
    "mcp",
    "homebox",
    "inventory",
    "home-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5"
  }
}
